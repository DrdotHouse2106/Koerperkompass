    "Alle Quests eines Tages geschafft: +%lld XP Bonus. Eigene Quests hakst du durch Antippen ab.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All quests of a day done: +%lld XP bonus. Tap your own quests to tick them off."
