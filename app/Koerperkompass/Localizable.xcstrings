    "Dafür braucht es Claude auf deinem Server (mit Zustimmung) oder Apple Intelligence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This needs Claude on your server (with consent) or Apple Intelligence."
          }
        }
      }
    },
    "Damit der Coach antworten kann, muss auf deinem Server ein Claude-API-Key eingetragen sein (ANTHROPIC_API_KEY, siehe Anleitung).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the coach to answer, a Claude API key must be set on your server (ANTHROPIC_API_KEY, see guide)."
          }
        }
      }
    },
