        }
      }
    },
    "Die Trainingstage kommen reihum dran. Ein laufendes Programm wird ersetzt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training days rotate. A running program will be replaced."
          }
        }
      }
    },
    "Die Werte sind Schätzungen und ersetzen keine ärztliche oder ernährungsfachliche Beratung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These values are estimates and no substitute for medical or nutritional advice."
