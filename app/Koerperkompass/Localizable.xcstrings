    "Meine verdammte Kaffeetasse leistet mehr als du, und die steht nur rum! DRÜCK!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My damn coffee mug does more work than you, and it just sits there! PUSH!"
