    "Meine Übungen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My exercises"
          }
        }
      }
    },
    "Meldet Abläufe wie Tippen, Abgleich, Server-Aufrufe und Fehler an deinen eigenen Server, damit Fehler gefunden werden können – nur Kennungen und Zeitstempel, keine Gesundheitswerte. Wird nicht weitergegeben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports activity such as taps, syncs, server calls and errors to your own server so bugs can be found – only IDs and timestamps, no health values. Never shared."
          }
        }
      }
    },
    "Menge": {
      "localizations": {
